{
  "backbone": "3dcoca",
  "dataset": "scene_nr3d",
  "data_root": "data",
  "scan_root": "data/scannet/scannet_data",
  "metadata_root": "data/scannet/meta_data",
  "checkpoint_dir": "outputs/3dcoca_nr3d",
  "quality_scores": "outputs/quality/3dcoca_nr3d.json",
  "strategy": "diq",
  "ratios": [
    0.25,
    0.5,
    0.75
